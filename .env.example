# ============================================================
# Proyectos Vialcar — Variables de entorno
# Copia este archivo a `.env.local` y rellena los valores reales.
# `.env.local` está en .gitignore — NUNCA lo subas al repo.
# ============================================================

# --- SMTP (IONOS) ------------------------------------------------
# Host SMTP de IONOS para España.
SMTP_HOST=smtp.ionos.es

# Puerto:
#   587 → STARTTLS (recomendado por IONOS)
#   465 → SSL/TLS
SMTP_PORT=587

# Usuario = email completo del buzón emisor (info@vialcar.es).
SMTP_USER=info@vialcar.es

# Contraseña del buzón. Cámbiala en el panel de IONOS si se compromete.
SMTP_PASS=

# --- Destinatario ------------------------------------------------
# A quién llegan los mensajes del formulario de contacto.
MAIL_TO=info@vialcar.es

# Nombre visible como remitente en el email.
MAIL_FROM_NAME=Web Proyectos Vialcar

# --- Analítica ---------------------------------------------------
# Vercel Analytics y Speed Insights NO necesitan configuración: se activan
# desde el dashboard de Vercel (Project → Analytics). Son sin cookies.
#
# Las dos de abajo están vacías a propósito. Mientras lo estén, la web no
# carga ningún script de terceros ni escribe cookies de seguimiento.
#
# ⚠️ RGPD: antes de rellenarlas hay que publicar un banner de consentimiento.
# GA4 arranca con Consent Mode en `denied` (no recoge nada hasta que el
# banner llame a gtag('consent','update')). El Pixel de Meta NO tiene
# equivalente — escribe cookies en cuanto carga, así que no lo actives sin
# banner funcionando.

# ID de medición de Google Analytics 4 — formato G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# ID del Pixel de Meta — solo dígitos
NEXT_PUBLIC_META_PIXEL_ID=
